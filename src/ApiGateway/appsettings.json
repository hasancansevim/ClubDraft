{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "session-route": {
        "ClusterId": "session-cluster",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        }
      },
      "draft-route": {
        "ClusterId": "draft-cluster",
        "Match": {
          "Path": "/api/drafts/{**catch-all}"
        }
      },
      "realtimehub-route": {
        "ClusterId": "realtimehub-cluster",
        "Match": {
          "Path": "/gameHub/{**catch-all}"
        }
      },
      "clubmanagement-route": {
        "ClusterId": "clubmanagement-cluster",
        "Match": {
          "Path": "/api/clubs/{**catch-all}"
        }
      },
      "financesponsorship-route": {
        "ClusterId": "financesponsorship-cluster",
        "Match": {
          "Path": "/api/finances/{**catch-all}"
        }
      },
      "matchengine-route": {
        "ClusterId": "matchengine-cluster",
        "Match": {
          "Path": "/api/matches/{**catch-all}"
        }
      },
      "reputationfan-route": {
        "ClusterId": "reputationfan-cluster",
        "Match": {
          "Path": "/api/reputation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "session-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5006" }
        }
      },
      "draft-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5007" }
        }
      },
      "realtimehub-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5010" }
        }
      },
      "clubmanagement-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5276" }
        }
      },
      "financesponsorship-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5008" }
        }
      },
      "matchengine-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5123" }
        }
      },
      "reputationfan-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5135" }
        }
      }
    }
  }
}
